# ---------------------------------------------------------------------------
# Deployment configuration for deploy/deploy.sh
# ---------------------------------------------------------------------------
# Copy this file to `deploy/.env.deploy`, fill in your values, and keep it out of
# version control (it is already covered by .gitignore). Nothing here is secret:
# it is bucket and distribution identifiers, which are not credentials. The AWS
# CLI uses your normal credential chain, so never put access keys in this file.

# The S3 bucket that holds the static export.
BUCKET=toolnova-site

# The CloudFront distribution id that serves the bucket.
# Find it with:  aws cloudfront list-distributions --query "DistributionList.Items[].{Id:Id,Alias:Aliases.Items[0]}"
DISTRIBUTION_ID=EXXXXXXXXXXXXX

# Region the bucket lives in. CloudFront is global; the bucket is regional.
AWS_REGION=us-east-1

# The canonical origin. This is baked into the build, so it must match your
# CloudFront alias or custom domain exactly, with no trailing slash.
# It overrides NEXT_PUBLIC_SITE_URL from .env.local for this deploy.
NEXT_PUBLIC_SITE_URL=https://www.toolforforever.com

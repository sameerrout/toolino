# ============================================================
# Toolnova Environment Configuration Template (.env.example)
# ============================================================
# Copy this file to `.env.local` for local development.
# Configure real production credentials in your AWS environment (ECS, App Runner, or Lambda).

# ------------------------------------------------------------
# 1. Site & Domain Configuration
# ------------------------------------------------------------
# Canonical public origin used for canonical URLs, sitemaps, robots.txt,
# Open Graph, Twitter cards, JSON-LD, and email reset links.
# Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.toolforforever.com

# ------------------------------------------------------------
# 2. Database Configuration (Amazon RDS PostgreSQL)
# ------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM.
# Format: postgresql://USER:PASSWORD@RDS_HOST:5432/DATABASE?schema=public&sslmode=require
DATABASE_URL=postgresql://postgres:replace-with-db-password@your-rds-endpoint.amazonaws.com:5432/toolnova?schema=public

# ------------------------------------------------------------
# 3. Authentication & Sessions
# ------------------------------------------------------------
# Server-only cryptographic key for signing and verifying HMAC session tokens (32+ random characters).
# NEVER expose this via NEXT_PUBLIC_* or commit the real secret to Git.
SESSION_SECRET=replace-with-a-long-random-secret

# Server-only HMAC secret for privacy-preserving visitor IP address deduplication.
# If omitted, SESSION_SECRET is used as fallback.
ANALYTICS_HMAC_SECRET=replace-with-a-long-random-hmac-secret

# Authorized manager email addresses (comma-separated, checked server-side)
MANAGER_EMAILS=sameerrout2004@gmail.com,sonysampangi9@gmail.com
# Optional master manager password fallback
MANAGER_PASSWORD=replace-with-secure-manager-password

# ------------------------------------------------------------
# 4. Google OAuth 2.0 (Google Identity Services)
# ------------------------------------------------------------
# Obtain credentials from Google Cloud Console (APIs & Services > Credentials).
# Authorized JavaScript Origins:
#   Development: http://localhost:3000, http://localhost:3001
#   Production:  https://your-production-domain
# Authorized Redirect URIs:
#   https://your-production-domain/api/auth/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------
# 5. Transactional Email (Amazon SES / SMTP)
# ------------------------------------------------------------
# Used for secure password reset links and transactional notifications.
EMAIL_FROM=Toolnova <noreply@toolnova.com>
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_PROVIDER_API_KEY=

# ------------------------------------------------------------
# 6. Optional Analytics & Monetization
# ------------------------------------------------------------
# Google AdSense publisher id (e.g. ca-pub-XXXXXXXXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# ------------------------------------------------------------
# 7. Optional Self-Hosted AI Model Assets
# ------------------------------------------------------------
# By default Tesseract language data and background-removal ONNX models are
# fetched from public CDNs. To host on your own S3/CloudFront bucket:
NEXT_PUBLIC_OCR_ASSET_BASE=
NEXT_PUBLIC_BG_REMOVAL_ASSET_BASE=
